# =============================================================================
# AI食品在庫・発注管理 環境変数サンプル
# このファイルをコピーして .env.local を作成してください（.env.local はコミットしない）。
# =============================================================================

# --- Supabase（必須） ---------------------------------------------------------
# Supabase ダッシュボード > Project Settings > API
# NEXT_PUBLIC_ で始まる値はブラウザに公開されます。公開可能な URL と anon（publishable）キーのみを設定してください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- seed スクリプト専用（アプリ本体では使用しない） --------------------------
# service role key は RLS をバイパスする秘密情報です。Vercel の環境変数には登録不要です。
SUPABASE_SERVICE_ROLE_KEY=

# --- 固定デモセッション（必須） -----------------------------------------------
# 閲覧者に認証操作を要求せず、サーバー側でRLS用セッションを自動確立するために使います。
# 値はブラウザへ送信されません。seed 実行時にデモ実行主体が作成されます。
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# true にするとデモ組織を閲覧専用にします（seed 実行時に反映）
DEMO_READONLY=false

# --- AI 説明（任意） ----------------------------------------------------------
# 未設定の場合は、決定論的なテンプレート説明で動作します（アプリは停止しません）。
OPENAI_API_KEY=
# 省略時: gpt-4o-mini
OPENAI_MODEL=
# OpenAI 互換 API を使う場合のみ（省略時: https://api.openai.com/v1）
OPENAI_BASE_URL=

# --- seed オプション（任意） --------------------------------------------------
# 乱数シード（同じ値なら毎回同じデータを生成）
SEED=20260913
# 生成する商品数（既定 1000）
SEED_PRODUCT_COUNT=1000
# 仕入先数（30〜50 推奨）
SEED_SUPPLIER_COUNT=40
# 入出庫履歴を生成する日数（既定 45。Free プランでは 30 程度を推奨）
SEED_HISTORY_DAYS=45
