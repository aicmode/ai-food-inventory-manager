# =============================================================================
# AI食品在庫・発注管理
# 公開販売デモは環境変数なしでも起動します。
# =============================================================================

# --- Public demo（Vercelではこの1項目だけで公開可能） -------------------------
# 未設定時も安全側のdemoになります。
NEXT_PUBLIC_APP_MODE=demo

# 任意。https:// または http:// の導入相談URLを設定した場合だけCTAを表示します。
NEXT_PUBLIC_CONTACT_URL=

# --- Client production only（顧客導入時のみ） --------------------------------
# NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional AI explanation（Client Production only） -----------------------
# 未設定時は決定論的なテンプレート説明を使います。
# Demo Modeでは設定されていても外部AI APIを呼び出しません（Vercelへ登録不要）。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- Local seed / DB integration tests only ----------------------------------
# Vercelには登録しません。service role keyをブラウザへ公開しないでください。
SUPABASE_SERVICE_ROLE_KEY=
SEED=20260913
SEED_PRODUCT_COUNT=1000
SEED_SUPPLIER_COUNT=40
SEED_HISTORY_DAYS=45
SEED_OWNER_EMAIL=
DEMO_READONLY=false
